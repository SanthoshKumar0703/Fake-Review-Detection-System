/* ==========================================================================
   Verdict — Fake Review Detection System
   Design language: "forensic case file" — dark ink desk, lit paper cards,
   scanline verification motif, serif authority headlines + mono data readouts.
   ========================================================================== */

:root {
  --ink: #0B131C;
  --ink-2: #121D29;
  --ink-3: #182634;
  --paper: #F6F2E7;
  --paper-dim: #EAE4D3;
  --teal: #2FBFAA;
  --teal-dim: #1D8A7A;
  --rust: #E27D45;
  --rust-dim: #C7602A;
  --ink-text: #E9EDF1;
  --ink-text-dim: #8FA0AF;
  --line: rgba(233, 237, 241, 0.10);
  --line-strong: rgba(233, 237, 241, 0.18);
  --shadow: 0 20px 60px rgba(0,0,0,0.45);
  --radius: 14px;
  --radius-sm: 8px;
  --font-display: "Fraunces", Georgia, serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: "JetBrains Mono", "Courier New", monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--ink);
  color: var(--ink-text);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 600; line-height: 1.15; margin: 0; }
p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
button { font-family: inherit; cursor: pointer; }
input, textarea, select { font-family: inherit; }

::selection { background: var(--rust); color: var(--ink); }

:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
}

.container { max-width: 1180px; margin: 0 auto; padding: 0 28px; }

/* ---------------------------------------------------------------------- */
/* Navbar                                                                  */
/* ---------------------------------------------------------------------- */
.navbar {
  position: sticky; top: 0; z-index: 100;
  background: rgba(11, 19, 28, 0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.nav-inner {
  max-width: 1180px; margin: 0 auto; padding: 16px 28px;
  display: flex; align-items: center; justify-content: space-between;
}
.brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--ink-text); }
.brand-mark { color: var(--teal); display: inline-flex; }
.brand-dot { color: var(--rust); }
.nav-links { display: flex; align-items: center; gap: 22px; }
.nav-link { font-size: 14.5px; color: var(--ink-text-dim); transition: color .15s ease; position: relative; }
.nav-link:hover { color: var(--ink-text); }
.nav-link.active { color: var(--teal); }
.nav-user { font-size: 13px; color: var(--ink-text-dim); font-family: var(--font-mono); }
.nav-user strong { color: var(--ink-text); font-weight: 500; }
.nav-toggle { display: none; flex-direction: column; gap: 4px; background: none; border: none; padding: 8px; }
.nav-toggle span { width: 22px; height: 2px; background: var(--ink-text); display: block; }

/* ---------------------------------------------------------------------- */
/* Buttons                                                                 */
/* ---------------------------------------------------------------------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 22px; border-radius: 999px; font-size: 14.5px; font-weight: 600;
  border: 1px solid transparent; transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
  white-space: nowrap;
}
.btn-primary { background: var(--teal); color: #05201B; }
.btn-primary:hover { background: #3ED2BC; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(47,191,170,0.25); }
.btn-secondary { background: var(--rust); color: #2B1204; }
.btn-secondary:hover { background: #EF8A54; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(226,125,69,0.25); }
.btn-ghost { background: transparent; color: var(--ink-text); border-color: var(--line-strong); }
.btn-ghost:hover { border-color: var(--teal); color: var(--teal); }
.btn-outline { background: transparent; color: var(--ink); border-color: var(--ink); }
.btn-outline:hover { background: var(--ink); color: var(--paper); }
.btn-sm { padding: 9px 18px; font-size: 13.5px; }
.btn-lg { padding: 15px 30px; font-size: 16px; }
.btn-block { width: 100%; }
.btn:disabled { opacity: .5; cursor: not-allowed; transform: none !important; }

/* ---------------------------------------------------------------------- */
/* Flash messages                                                          */
/* ---------------------------------------------------------------------- */
.flash-stack { max-width: 1180px; margin: 16px auto 0; padding: 0 28px; display: flex; flex-direction: column; gap: 10px; }
.flash {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 13px 18px; border-radius: var(--radius-sm); font-size: 14px;
  border: 1px solid var(--line-strong);
}
.flash-success { background: rgba(47,191,170,0.12); border-color: rgba(47,191,170,0.35); color: #9FEFE1; }
.flash-error { background: rgba(226,125,69,0.12); border-color: rgba(226,125,69,0.35); color: #F5C09B; }
.flash-close { background: none; border: none; color: inherit; font-size: 18px; line-height: 1; opacity: .7; }
.flash-close:hover { opacity: 1; }

/* ---------------------------------------------------------------------- */
/* Hero + scanner signature element                                       */
/* ---------------------------------------------------------------------- */
.hero {
  padding: 88px 0 100px;
  background:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(47,191,170,0.10), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 10%, rgba(226,125,69,0.08), transparent 60%);
}
.hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: center; }
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono);
  font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal);
  border: 1px solid rgba(47,191,170,0.35); padding: 6px 12px; border-radius: 999px; margin-bottom: 22px;
}
.eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 3px rgba(47,191,170,0.25); }
.hero h1 {
  font-size: clamp(38px, 5vw, 58px); color: var(--ink-text); letter-spacing: -0.01em;
}
.hero h1 em { font-style: normal; color: var(--teal); }
.hero-lede { margin-top: 22px; font-size: 18px; color: var(--ink-text-dim); max-width: 500px; }
.hero-actions { margin-top: 34px; display: flex; gap: 14px; flex-wrap: wrap; }
.hero-meta { margin-top: 40px; display: flex; gap: 34px; flex-wrap: wrap; }
.hero-meta-item { font-family: var(--font-mono); }
.hero-meta-num { font-size: 26px; color: var(--ink-text); display: block; font-weight: 700; }
.hero-meta-label { font-size: 12px; color: var(--ink-text-dim); text-transform: uppercase; letter-spacing: .06em; }

/* the scanner card */
.scanner-card {
  background: var(--paper);
  border-radius: var(--radius);
  padding: 26px;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
  color: #1B2430;
}
.scanner-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.scanner-tag { font-family: var(--font-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: .08em; color: #6B7785; }
.scanner-id { font-family: var(--font-mono); font-size: 11.5px; color: #6B7785; }
.scanner-text {
  font-size: 15px; line-height: 1.65; color: #2C3644;
  border-left: 3px solid var(--paper-dim); padding-left: 16px;
}
.scanner-viewport { position: relative; margin-top: 20px; padding: 18px 0; border-top: 1px dashed #D8D0BC; }
.scanline {
  position: absolute; left: 0; right: 0; top: 0; height: 3px;
  background: linear-gradient(90deg, transparent, var(--teal), transparent);
  box-shadow: 0 0 16px 2px rgba(47,191,170,0.6);
  animation: sweep 3.2s cubic-bezier(.6,0,.4,1) infinite;
}
@keyframes sweep {
  0% { top: 0; opacity: 0; }
  8% { opacity: 1; }
  48% { top: 100%; opacity: 1; }
  55% { opacity: 0; }
  100% { top: 100%; opacity: 0; }
}
.verdict-row { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
.verdict-stamp {
  font-family: var(--font-display); font-weight: 700; font-size: 22px;
  letter-spacing: .04em; text-transform: uppercase;
  border: 2.5px solid var(--rust); color: var(--rust);
  padding: 6px 16px; border-radius: 6px; transform: rotate(-4deg);
  animation: stamp-in 3.2s ease infinite;
}
@keyframes stamp-in {
  0%, 55% { opacity: 0; transform: rotate(-4deg) scale(1.4); }
  65%, 92% { opacity: 1; transform: rotate(-4deg) scale(1); }
  100% { opacity: 1; transform: rotate(-4deg) scale(1); }
}
.confidence-readout { font-family: var(--font-mono); text-align: right; }
.confidence-readout .num { font-size: 26px; font-weight: 700; color: #1B2430; }
.confidence-readout .lbl { font-size: 11px; color: #6B7785; text-transform: uppercase; letter-spacing: .06em; }
.scanner-flags { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
.scanner-flag { font-family: var(--font-mono); font-size: 11px; background: #FBEAE0; color: var(--rust-dim); padding: 4px 10px; border-radius: 999px; }

/* ---------------------------------------------------------------------- */
/* Section shells                                                          */
/* ---------------------------------------------------------------------- */
.section { padding: 96px 0; }
.section-dark { background: var(--ink); }
.section-paper { background: var(--paper); color: #1B2430; }
.section-head { max-width: 640px; margin-bottom: 56px; }
.section-eyebrow { font-family: var(--font-mono); font-size: 12.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--teal); margin-bottom: 12px; display: block; }
.section-paper .section-eyebrow { color: var(--teal-dim); }
.section-head h2 { font-size: clamp(28px, 3.4vw, 40px); }
.section-head p { margin-top: 16px; font-size: 17px; color: var(--ink-text-dim); }
.section-paper .section-head p { color: #5B6673; }

/* Features grid */
.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
.feature-card { background: var(--ink-2); padding: 30px 26px; transition: background .2s ease; }
.feature-card:hover { background: var(--ink-3); }
.feature-icon { color: var(--teal); margin-bottom: 18px; }
.feature-card h3 { font-size: 17px; color: var(--ink-text); margin-bottom: 10px; font-weight: 600; font-family: var(--font-body); }
.feature-card p { font-size: 14px; color: var(--ink-text-dim); line-height: 1.6; }

/* How it works — process rail (numbered because it IS a sequence) */
.process-rail { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; position: relative; }
.process-step { position: relative; padding-top: 8px; }
.process-num { font-family: var(--font-mono); font-size: 13px; color: var(--rust); border-bottom: 2px solid var(--rust); display: inline-block; padding-bottom: 6px; margin-bottom: 18px; }
.process-step h3 { font-size: 17px; margin-bottom: 8px; color: #1B2430; font-family: var(--font-body); font-weight: 600; }
.process-step p { font-size: 14px; color: #5B6673; }

/* Stat band */
.stat-band { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.stat-band-item { padding: 40px 26px; text-align: center; border-right: 1px solid var(--line); }
.stat-band-item:last-child { border-right: none; }
.stat-band-num { font-family: var(--font-mono); font-size: 34px; font-weight: 700; color: var(--teal); }
.stat-band-label { margin-top: 8px; font-size: 13px; color: var(--ink-text-dim); text-transform: uppercase; letter-spacing: .05em; }

/* CTA band */
.cta-band { padding: 90px 0; text-align: center; background: linear-gradient(180deg, var(--ink), var(--ink-2)); }
.cta-band h2 { font-size: clamp(28px, 3.6vw, 42px); color: var(--ink-text); max-width: 640px; margin: 0 auto 22px; }
.cta-band p { color: var(--ink-text-dim); font-size: 17px; margin-bottom: 34px; }

/* Footer */
.site-footer { border-top: 1px solid var(--line); padding: 30px 0; }
.footer-inner { max-width: 1180px; margin: 0 auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.footer-brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-weight: 600; color: var(--ink-text); }
.footer-note { font-size: 13px; color: var(--ink-text-dim); }

/* ---------------------------------------------------------------------- */
/* Auth pages                                                              */
/* ---------------------------------------------------------------------- */
.auth-shell {
  min-height: calc(100vh - 140px);
  display: flex; align-items: center; justify-content: center;
  padding: 60px 28px;
  background: radial-gradient(ellipse 800px 500px at 50% 0%, rgba(47,191,170,0.08), transparent 60%);
}
.auth-card {
  width: 100%; max-width: 420px; background: var(--ink-2);
  border: 1px solid var(--line); border-radius: var(--radius); padding: 40px 36px;
  box-shadow: var(--shadow);
}
.auth-card .eyebrow { margin-bottom: 18px; }
.auth-card h1 { font-size: 28px; color: var(--ink-text); margin-bottom: 8px; }
.auth-card .sub { color: var(--ink-text-dim); font-size: 14.5px; margin-bottom: 30px; }
.field { margin-bottom: 20px; }
.field label { display: block; font-size: 13px; color: var(--ink-text-dim); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .04em; }
.field input, .field textarea, .field select {
  width: 100%; background: var(--ink); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  padding: 13px 14px; color: var(--ink-text); font-size: 14.5px; transition: border-color .15s ease;
}
.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--teal); outline: none; }
.field input::placeholder, .field textarea::placeholder { color: #56626D; }
.auth-foot { margin-top: 24px; text-align: center; font-size: 14px; color: var(--ink-text-dim); }
.auth-foot a { color: var(--teal); font-weight: 600; }

/* ---------------------------------------------------------------------- */
/* App shell (dashboard / analyze / reports)                               */
/* ---------------------------------------------------------------------- */
.app-shell { background: var(--paper); color: #1B2430; min-height: calc(100vh - 140px); padding: 44px 0 80px; }
.app-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 34px; }
.app-header .kicker { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--teal-dim); display: block; margin-bottom: 8px; }
.app-header h1 { font-size: 32px; color: #1B2430; }
.app-header p { color: #5B6673; margin-top: 6px; font-size: 14.5px; }

.card { background: #fff; border: 1px solid #E4DFCF; border-radius: var(--radius); }

/* Dashboard stat cards */
.stat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 30px; }
.stat-card { padding: 24px; position: relative; overflow: hidden; }
.stat-card .label { font-size: 12.5px; text-transform: uppercase; letter-spacing: .05em; color: #6B7785; }
.stat-card .value { font-family: var(--font-mono); font-size: 32px; font-weight: 700; margin-top: 10px; color: #1B2430; }
.stat-card.accent-teal .value { color: var(--teal-dim); }
.stat-card.accent-rust .value { color: var(--rust-dim); }
.stat-card .sub { font-size: 12.5px; color: #8A93A0; margin-top: 6px; }

.dash-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-bottom: 24px; }
.panel { padding: 26px; }
.panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.panel-head h2 { font-size: 16px; font-weight: 600; font-family: var(--font-body); }
.panel-head .tag { font-family: var(--font-mono); font-size: 11.5px; color: #8A93A0; }

.recent-list { display: flex; flex-direction: column; gap: 0; }
.recent-item { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 13px 0; border-bottom: 1px solid #EFEBDF; }
.recent-item:last-child { border-bottom: none; }
.recent-text { font-size: 13.5px; color: #3B4552; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 340px; }
.badge { font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; letter-spacing: .03em; white-space: nowrap; }
.badge-fake { background: rgba(226,125,69,0.14); color: var(--rust-dim); }
.badge-genuine { background: rgba(47,191,170,0.14); color: var(--teal-dim); }

/* ---------------------------------------------------------------------- */
/* Analyze page                                                            */
/* ---------------------------------------------------------------------- */
.analyze-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start; }
.analyze-tabs { display: flex; gap: 8px; margin-bottom: 18px; }
.tab-btn { padding: 9px 16px; border-radius: 999px; font-size: 13.5px; font-weight: 600; border: 1px solid #E4DFCF; background: #fff; color: #5B6673; }
.tab-btn.active { background: #1B2430; color: #fff; border-color: #1B2430; }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

.textarea-wrap { padding: 24px; }
.char-count { text-align: right; font-family: var(--font-mono); font-size: 12px; color: #8A93A0; margin-top: 8px; }

.result-card { padding: 26px; }
.result-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 20px; color: #8A93A0; }
.result-empty svg { margin-bottom: 16px; color: #C9C2AC; }

.verdict-banner { display: flex; align-items: center; justify-content: space-between; padding: 20px; border-radius: var(--radius-sm); margin-bottom: 20px; }
.verdict-banner.fake { background: rgba(226,125,69,0.10); border: 1px solid rgba(226,125,69,0.3); }
.verdict-banner.genuine { background: rgba(47,191,170,0.10); border: 1px solid rgba(47,191,170,0.3); }
.verdict-banner .vb-label { font-family: var(--font-display); font-size: 22px; font-weight: 700; text-transform: uppercase; }
.verdict-banner.fake .vb-label { color: var(--rust-dim); }
.verdict-banner.genuine .vb-label { color: var(--teal-dim); }
.verdict-banner .vb-sub { font-size: 12.5px; color: #6B7785; margin-top: 4px; }

.confidence-meter { margin-bottom: 22px; }
.confidence-meter .cm-top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 13px; margin-bottom: 8px; }
.cm-track { height: 10px; background: #EFEBDF; border-radius: 999px; overflow: hidden; }
.cm-fill { height: 100%; border-radius: 999px; transition: width .6s ease; }
.cm-fill.fake { background: linear-gradient(90deg, var(--rust-dim), var(--rust)); }
.cm-fill.genuine { background: linear-gradient(90deg, var(--teal-dim), var(--teal)); }

.signal-list { display: flex; flex-direction: column; gap: 10px; }
.signal-item { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; color: #3B4552; padding: 10px 12px; background: #FAF8F0; border-radius: 8px; }
.signal-item svg { flex-shrink: 0; margin-top: 2px; color: var(--rust-dim); }
.no-signals { font-size: 13.5px; color: #6B7785; padding: 10px 0; }

.dropzone {
  border: 2px dashed #D8D0BC; border-radius: var(--radius-sm); padding: 34px 20px; text-align: center;
  transition: border-color .15s ease, background .15s ease; cursor: pointer;
}
.dropzone:hover, .dropzone.dragover { border-color: var(--teal); background: rgba(47,191,170,0.05); }
.dropzone svg { color: #8A93A0; margin-bottom: 12px; }
.dropzone .dz-title { font-weight: 600; font-size: 14.5px; color: #1B2430; }
.dropzone .dz-sub { font-size: 12.5px; color: #8A93A0; margin-top: 6px; }
.dz-filename { margin-top: 12px; font-family: var(--font-mono); font-size: 12.5px; color: var(--teal-dim); }

/* ---------------------------------------------------------------------- */
/* Reports page                                                            */
/* ---------------------------------------------------------------------- */
.filter-bar { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; padding: 18px 22px; margin-bottom: 22px; }
.filter-bar input[type=text] { flex: 1; min-width: 220px; border: 1px solid #E4DFCF; border-radius: var(--radius-sm); padding: 11px 14px; font-size: 14px; }
.filter-chip { padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 600; border: 1px solid #E4DFCF; background: #fff; color: #5B6673; }
.filter-chip.active { background: #1B2430; color: #fff; border-color: #1B2430; }
.export-actions { display: flex; gap: 10px; margin-left: auto; }

.report-table { width: 100%; border-collapse: collapse; }
.report-table thead th {
  text-align: left; font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; color: #8A93A0;
  padding: 14px 22px; border-bottom: 1px solid #EFEBDF; font-weight: 600;
}
.report-table tbody td { padding: 16px 22px; border-bottom: 1px solid #F2EFE4; font-size: 13.5px; vertical-align: top; }
.report-table tbody tr:last-child td { border-bottom: none; }
.report-table tbody tr:hover { background: #FAF8F0; }
.rt-review { max-width: 380px; color: #3B4552; }
.rt-conf { font-family: var(--font-mono); }
.rt-signals { color: #8A93A0; font-size: 12.5px; max-width: 260px; }
.rt-empty { text-align: center; padding: 60px 20px; color: #8A93A0; }

/* ---------------------------------------------------------------------- */
/* Responsive                                                              */
/* ---------------------------------------------------------------------- */
@media (max-width: 980px) {
  .hero-grid { grid-template-columns: 1fr; }
  .feature-grid { grid-template-columns: repeat(2, 1fr); }
  .process-rail { grid-template-columns: repeat(2, 1fr); }
  .stat-band { grid-template-columns: repeat(2, 1fr); }
  .stat-cards { grid-template-columns: repeat(2, 1fr); }
  .dash-grid { grid-template-columns: 1fr; }
  .analyze-grid { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .nav-toggle { display: flex; }
  .nav-links {
    position: absolute; top: 100%; left: 0; right: 0; background: var(--ink-2);
    flex-direction: column; align-items: flex-start; padding: 20px 28px; gap: 16px;
    border-bottom: 1px solid var(--line); display: none;
  }
  .nav-links.open { display: flex; }
  .feature-grid { grid-template-columns: 1fr; }
  .process-rail { grid-template-columns: 1fr; }
  .stat-band { grid-template-columns: repeat(2, 1fr); }
  .stat-cards { grid-template-columns: 1fr; }
  .filter-bar { flex-direction: column; align-items: stretch; }
  .export-actions { margin-left: 0; }
  .rt-review, .rt-signals { max-width: 200px; }
}
